#!/bin/bash
set -euo pipefail

RULES_FILE=/etc/udev/rules.d/98-superbird.rules

echo "Root permissions are required to modify udev rules. Please enter your password to continue."
sudo -v

echo "Writing $RULES_FILE"
sudo tee "$RULES_FILE" >/dev/null <<'EOF'
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b8e", ATTRS{idProduct}=="c003", GROUP="users", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", ATTRS{idProduct}=="4e40", GROUP="users", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="1014", GROUP="users", MODE="0666"
EOF

echo "Reloading udev rules"
sudo udevadm control --reload-rules
sudo udevadm trigger

echo "The udev rules are now installed. Unplug and replug the Car Thing, then try connecting again."
